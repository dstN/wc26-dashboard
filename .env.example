MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=wc26
MYSQL_USER=wc26user
MYSQL_PASSWORD=wc26pass
MYSQL_HOST=db
MYSQL_PORT=3306
PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
ALLOWED_ORIGIN=https://your-domain.com

# Contact form SMTP (use an app password, not your main account password)
# Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
CONTACT_TO_EMAIL=dustin.tramm@yinside.de

# PDF ingestion pipeline
# Path to drop folder for new EFI Post Match Summary PDF files.
# The watcher script (ingestion/watch_pdfs.py) scans this folder for
# unprocessed PDFs and ingests them automatically.
# For Apache/Phusion Passenger: set this to an absolute path outside
# your public_html directory (e.g. /home/username/pdf_drop)
PDF_WATCH_DIR=./pdfs

# Secure upload endpoint — set a strong random secret (e.g. openssl rand -hex 32).
# Leave empty to disable the endpoint entirely.
INGEST_SECRET_KEY=

# Passenger/bare-metal only: path to the Python interpreter that has the
# ingestion dependencies installed (pymupdf, sqlalchemy, pymysql, etc.).
# Default: python3 (assumes ingestion is in the same virtualenv as the backend)
INGESTION_PYTHON=python3

# Passenger/bare-metal only: working directory from which `python -m ingestion.watch_pdfs`
# is invoked. Set to the folder that CONTAINS the `ingestion/` package directory.
# Leave empty if the backend and ingestion share the same working directory.
INGESTION_MODULE_DIR=
